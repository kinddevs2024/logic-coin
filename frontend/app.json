{
  "expo": {
    "name": "Logic Coin",
    "slug": "logic-coin",
    "scheme": "logiccoin",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kinddevs.logiccoin"
    },
    "android": {
      "package": "com.kinddevs.logiccoin",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#F7FAFF",
        "foregroundImage": "./assets/brand/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/brand/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Logic Coin использует выбранное фото только как аватар профиля."
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-8830993776186608~3415573733",
          "iosAppId": "ca-app-pub-8830993776186608~3415573733",
          "userTrackingUsageDescription": "Logic Coin использует идентификатор устройства, чтобы показывать более подходящую рекламу."
        }
      ],
      "./plugins/with-appodeal",
      "./plugins/with-yandex-mobile-ads",
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/notification-icon.png",
          "color": "#0866FF"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7FAFF",
          "image": "./assets/brand/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
