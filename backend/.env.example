# Runtime
NODE_ENV=development
PORT=4000
APP_PUBLIC_URL=http://localhost:8081
API_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
DEFAULT_TIMEZONE=UTC

# MongoDB (never commit a real connection string)
MONGODB_URI=mongodb://localhost:27017/logic-coin
# The supplied infrastructure may alternatively use MONGODB_SYNC_TARGET_URI.
MONGODB_AUTO_INDEX=true

# Authentication (generate independent random values with at least 32 characters)
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ISSUER=logic-coin-api
JWT_AUDIENCE=logic-coin-app
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
OTP_PEPPER=replace-with-another-random-secret-at-least-32-characters
OTP_TTL_MINUTES=10
OTP_EXPOSE_CODE=false

# Email verification
EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-me
SMTP_PASS=replace-me
EMAIL_FROM=Logic Coin <no-reply@example.com>

# Social login
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_ID_WEB=replace-me-web.apps.googleusercontent.com
GOOGLE_CLIENT_ID_MOBILE=replace-me-mobile.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
YANDEX_CLIENT_ID=replace-me
YANDEX_CLIENT_SECRET=replace-me
YANDEX_REDIRECT_URIS=http://localhost:4000/api/v1/auth/yandex/callback

# Economy (integers only)
UNIT_VALUE_CENTS=1
MIN_WITHDRAWAL_CENTS=1000
REFERRAL_SIGNUP_REWARD_UNITS=50
# Comma-separated accounts allowed to use the regular app login as administrators.
ADMIN_EMAILS=

# Optional Expo Push enhanced-security token. The standard Expo endpoint works without it.
EXPO_PUSH_API_URL=https://exp.host/--/api/v2/push/send
EXPO_PUSH_ACCESS_TOKEN=

# Optional admin notification
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_BOT_USERNAME=replace-me
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-secret-at-least-16-characters
TELEGRAM_ADMIN_CHAT_ID=replace-me
