{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "npx --yes npm@11.18.0 ci",
  "buildCommand": "npm run build:web",
  "outputDirectory": "frontend/dist",
  "cleanUrls": true,
  "functions": {
    "api/index.ts": {
      "maxDuration": 20
    }
  },
  "headers": [
    {
      "source": "/app-ads.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/_vercel/(.*)",
      "destination": "/_vercel/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
