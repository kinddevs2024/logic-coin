{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "npx --yes npm@11.18.0 ci",
  "buildCommand": "npm run build:web",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 20
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/_vercel/(.*)",
      "destination": "/_vercel/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
